# Database Settings
DATABASE_URL=sqlite:///./inhouse.db

# FastAPI Backend Settings (127.0.0.1 = local-only; only the bot uses the API)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Public Dashboard Deployment Settings (the dashboard is what gets published)
# quick: free trycloudflare.com URL via Cloudflare Tunnel, URL changes each run (default)
# named: stable URL via Cloudflare Tunnel, requires a domain registered on Cloudflare
#        (set CLOUDFLARED_TUNNEL to the tunnel name and PUBLIC_URL to its hostname)
# port:  router port forwarding (external 8501 -> this machine) + DNS record
#        (set PUBLIC_URL, e.g. https://gol.example.com)
# none:  local only, no public deployment
PUBLIC_MODE=quick
CLOUDFLARED_TUNNEL=
PUBLIC_URL=
# PUBLIC_URL 이 비었을 때 공유 카드 푸터 등에 표기할 호스트
PUBLIC_HOST_FALLBACK=localhost
# 대시보드 외 출처에서 API를 브라우저로 호출할 때만 채운다(콤마 구분)
CORS_ALLOW_ORIGINS=

# External write (POST/PUT/DELETE) requests must send this as X-API-Key header.
# Leave empty and run.sh will generate one automatically.
API_KEY=

# DuckDNS (free DDNS, https://www.duckdns.org)
# Set both values and run.sh keeps <DUCKDNS_DOMAIN>.duckdns.org pointed at the
# current home IP while running. Point the public domain to it with a CNAME.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
START_DASHBOARD=1
START_BOT=1
# macOS 유휴 절전 방지(봇 게이트웨이 끊김 → 슬래시 명령 10062 만료 예방). 0 이면 끔.
KEEP_AWAKE=1
AUTO_INSTALL_DEPS=1
DASHBOARD_PORT=8501

# Discord Bot Settings
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 봇 기본 상태 메시지 (예: "플레이어 등록문의 @관리자")
BOT_DEFAULT_STATUS=

# 서버 Administrator 권한 없이도 관리자 명령을 쓸 수 있는 디스코드 유저 ID(콤마 구분, 예: 123,456)
ADMIN_DISCORD_IDS=

# DeepLOL Clash Settings (커스텀 게임 코드 생성용)
CLASH_PASSWORD=your_clash_password_here

# Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120

# Scraping Settings
SYNC_INTERVAL_MINUTES=45
